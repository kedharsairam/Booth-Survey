<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing in this app is ever uploaded. Used on Android 11 and below; Android 12+ reads
  data_extraction_rules.xml instead, and both are set to exclude the same things.

  This app holds real people's names, government voter IDs, home addresses, caste and party
  affiliation. Android's automatic backup is on by default and uploads all of it to Google
  Drive with no permission, no prompt and no opt-out inside the app. A surveyor who has never
  heard of cloud backup would have no idea that pressing "Backup" on his phone meant sending
  a whole booth roll to a server he never agreed to.

  The app takes its own backups instead, in places he chooses and can see: the automatic one
  to Downloads/Booth Survey/, the manual one wherever the system save dialog sends it. That
  is a decision made on the device, by a person, to a folder they know about. This file is
  what stops a second, invisible one being made on somebody else's behalf.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>