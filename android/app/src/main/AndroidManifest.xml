<?xml version="1.0" encoding="utf-8"?>
<!--
  No <uses-permission> of any kind, deliberately.

  The roll is imported from a file he picks and edited in internal storage, exports go
  through the system file picker, and nothing talks to a network. Every one of those is
  possible without a permission, so asking for one would be asking the user for trust the
  app does not need.

  Note what is NOT here: android:allowBackup. It was "true" until this was checked against
  the Secure principle, which was a serious miss. Left alone, Android uploads the whole app
  folder — every voter's name, voter ID, address, caste and party — to the user's Google
  Drive, and on Android 12+ hands it to a replacement phone as well. No permission, no
  prompt, no opt-out, and nothing in the app that said so. It is now off twice over:
  "false" here, and both transports excluded in res/xml/, because allowBackup on its own
  does not stop device-to-device transfer on every phone.

  The app takes its own backups instead, to places he can see and reach: the automatic one
  to Downloads/Booth Survey/, the manual one wherever the system save dialog sends it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      AndroidX Core injects a signature-level permission of its own,
      DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION, so that context-registered receivers are
      safe on older releases. It grants this app nothing: it is defined by this same APK
      and never appears in an install prompt. But it is still a uses-permission line, and
      "zero permissions" should mean zero lines rather than "none that matter". Removed so
      that the manifest says exactly what it means.
    -->
    <uses-permission
        android:name="com.kraft.voterlist.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />


    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoterList">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>